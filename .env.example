# CashO Environment Configuration Template
# Copy this file to .env and configure with your local credentials.
# NEVER commit .env to version control.

# Application Settings
DEBUG=True
DATABASE_URL=sqlite:///./backend/app/db/casho.db

# Google OAuth Credentials (for Gmail transaction sync)
# Obtain these from the Google Cloud Console (APIs & Services > Credentials > Web application)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/sync/gmail/callback

# Security: Fernet 32-byte url-safe base64 encryption key for token encryption at rest
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SYNC_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key_here

# Security: Secret Bearer API token for authorized Android companion app synchronization
ANDROID_API_KEY=your_secure_android_sync_bearer_key_here
